# Stock Intelligence - 智能选股分析系统配置

# 项目配置
PROJECT_ROOT=~/github-ai-tools/stock-intelligence
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
HOST=127.0.0.1
PUBLIC_BASE_URL=

# LLM配置（v0.1再实现）
LLM_PROVIDER=deepseek
LLM_API_KEY=your_key_here
# 分析请求与JSON格式修复分开重试；兼容服务不支持JSON模式时会自动回退。
LLM_JSON_MODE=auto
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192
LLM_ANALYSIS_RETRIES=2
LLM_FORMAT_RETRIES=1
LLM_REPAIR_TIMEOUT=45

# 新闻搜索（v0.1再实现）
SERPAPI_API_KEY=your_key_here
# 或
TAVILY_API_KEY=your_key_here

# 飞书推送（可选）
FEISHU_WEBHOOK_URL=your_webhook_here
# 模拟交易交互卡片必须配置飞书自建应用；Webhook只能发送普通报告。
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_RECEIVE_ID=your_chat_id
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_VERIFICATION_TOKEN=your_verification_token
# auto优先使用官方长连接；默认不回退到可能过期的临时公网地址。
FEISHU_CALLBACK_MODE=auto
# 只有已维护稳定的公网HTTPS回调时才设为true。
FEISHU_HTTP_FALLBACK_ENABLED=false
# HTTP备用模式的事件订阅地址: ${PUBLIC_BASE_URL}/api/feishu/callback
DEFAULT_NOTIFY=false
NOTIFY_RETRY_MAX=3

# 写接口必须配置；模拟交易完成验收前保持false。
API_KEY=replace_with_a_long_random_value
PAPER_TRADING_ENABLED=false

# AlphaSift配置（v0.1再实现）
ALPHASIFT_PATH=~/github-ai-tools/alphasift

# DSA配置（v0.1再实现）
DSA_PATH=~/github-ai-tools/daily_stock_analysis

# 用户权限配置
USER_BOARD_PERMISSIONS=main_board,etf

# 评估配置（v0.2再实现）
EVALUATION_COST_BPS=30
FOLLOW_THROUGH_PCT=5.0
FAILED_BREAKOUT_PCT=-3.0
BENCHMARK_INDEX=000300
