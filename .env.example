# Stock Intelligence - 智能选股分析系统配置

# 项目配置
PROJECT_ROOT=~/github-ai-tools/stock-intelligence
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# LLM配置（v0.1再实现）
LLM_PROVIDER=deepseek
LLM_API_KEY=your_key_here

# 新闻搜索（v0.1再实现）
SERPAPI_API_KEY=your_key_here
# 或
TAVILY_API_KEY=your_key_here

# 飞书推送（可选）
FEISHU_WEBHOOK_URL=your_webhook_here
# 模拟交易交互卡片必须配置飞书自建应用；Webhook只能发送普通报告。
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_RECEIVE_ID=your_chat_id
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_VERIFICATION_TOKEN=your_verification_token
DEFAULT_NOTIFY=false
NOTIFY_RETRY_MAX=3

# 写接口必须配置；模拟交易完成验收前保持false。
API_KEY=replace_with_a_long_random_value
PAPER_TRADING_ENABLED=false

# AlphaSift配置（v0.1再实现）
ALPHASIFT_PATH=~/github-ai-tools/alphasift

# DSA配置（v0.1再实现）
DSA_PATH=~/github-ai-tools/daily_stock_analysis

# 用户权限配置
USER_BOARD_PERMISSIONS=main_board,etf

# 评估配置（v0.2再实现）
EVALUATION_COST_BPS=30
FOLLOW_THROUGH_PCT=5.0
FAILED_BREAKOUT_PCT=-3.0
BENCHMARK_INDEX=000300
