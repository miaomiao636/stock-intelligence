# Stock Intelligence 自动化定时任务
# 使用项目 .venv (Python 3.11.15)，满足 pyproject requires-python>=3.11
#
# 导入方式（任选其一）：
#   方式A（合并到现有 crontab）: crontab -l 2>/dev/null; cat deploy/stock-intelligence.cron) | crontab -
#   方式B（覆盖，本项目专用）: crontab deploy/stock-intelligence.cron
#   方式C（查看）: crontab -l
#
# 注意：macOS 合盖/休眠时 crontab 不执行，建议保持唤醒或改用 launchd。

SHELL=/bin/zsh
PATH=/Users/Admin/github-ai-tools/stock-intelligence/.venv/bin:/usr/local/bin:/usr/bin:/bin

PY=/Users/Admin/github-ai-tools/stock-intelligence/.venv/bin/python
DIR=/Users/Admin/github-ai-tools/stock-intelligence

# 每日轮转超过10MB的服务日志，保留一个上一版本
5 0 * * * /bin/bash $DIR/deploy/rotate_logs.sh

# 盘前推荐（周一至周五 08:45）
45 8 * * 1-5 cd $DIR && $PY cli.py daily --mode morning >> /tmp/stock-intelligence-morning.log 2>&1
# 08:55检查成功回执；首次推送失败或进程中断时自动补发。
55 8 * * 1-5 cd $DIR && $PY cli.py notify --mode morning --if-missing >> /tmp/stock-intelligence-notify-watchdog.log 2>&1

# 13:15基于上午推荐和盘中实时行情做独立复核；只分析与推送，不直接下单
15 13 * * 1-5 cd $DIR && $PY cli.py daily --mode afternoon >> /tmp/stock-intelligence-afternoon.log 2>&1
# 13:25检查成功回执，避免分析成功但飞书漏推
25 13 * * 1-5 cd $DIR && $PY cli.py notify --mode afternoon --if-missing >> /tmp/stock-intelligence-notify-watchdog.log 2>&1

# 09:35重新取价并在风控通过后直接自动执行，成交结果推送飞书
35 9 * * 1-5 cd $DIR && $PY cli.py paper open >> /tmp/stock-intelligence-open.log 2>&1
# 09:45检查阶段回执；09:35中断或状态消息未送达时自动补跑一次。
45 9 * * 1-5 cd $DIR && $PY cli.py paper open --if-missing >> /tmp/stock-intelligence-open-watchdog.log 2>&1
# 恢复扫描：仅处理自动确认后因进程中断尚未成交的订单及历史遗留订单。
* 9-14 * * 1-5 cd $DIR && $PY cli.py paper execute-due >> /tmp/stock-intelligence-execute.log 2>&1
0 15 * * 1-5 cd $DIR && $PY cli.py paper execute-due >> /tmp/stock-intelligence-execute.log 2>&1

# 盘中内部检查；仅状态变化和风险事件推送飞书
5,35 10 * * 1-5 cd $DIR && $PY cli.py paper intraday >> /tmp/stock-intelligence-intraday.log 2>&1
5,25 11 * * 1-5 cd $DIR && $PY cli.py paper intraday >> /tmp/stock-intelligence-intraday.log 2>&1
5,35 13-14 * * 1-5 cd $DIR && $PY cli.py paper intraday >> /tmp/stock-intelligence-intraday.log 2>&1
55 14 * * 1-5 cd $DIR && $PY cli.py paper intraday >> /tmp/stock-intelligence-intraday.log 2>&1

# 盘后评估（周一至周五 16:45）
45 16 * * 1-5 cd $DIR && $PY cli.py daily --mode closing >> /tmp/stock-intelligence-closing.log 2>&1
# 16:55检查成功回执；降级报告也必须有明确推送结果。
55 16 * * 1-5 cd $DIR && $PY cli.py notify --mode closing --if-missing >> /tmp/stock-intelligence-notify-watchdog.log 2>&1
